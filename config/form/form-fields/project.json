{
  "title": "project",
  "display_name": {
    "en": "Project Information",
    "de": "Projekt"
  },
  "description": {
    "en": " Please provide information about your project",
    "de": "Bitte geben Sie Informationen zu Ihrem Projekt an"
  },
  "blocks": [
    {
      "label": "principal-investigator",
      "multiple": false,
      "min_instances": 1,
      "display_name": {
        "en": "Principal Investigator (Applicant)",
        "de": "Hauptverantwortlicher (Antragsteller)"
      },
      "description": {
        "en": "The applicant serves as the primary point of contact.",
        "de": "Der Antragsteller dient als primärer Ansprechpartner."
      }
    },
    {
      "label": "collaborators",
      "multiple": true,
      "display_name": {
        "en": "Collaborator",
        "de": "Kooperationspartner"
      },
      "description": {
        "en": "If applicable, please provide the names, affiliations, and email addresses of your collaborators at the chosen sites. All fields within a started entry are required.",
        "de": "Falls zutreffend, geben Sie bitte die Namen, Zugehörigkeiten und E-Mail-Adressen Ihrer Kooperationspartner an den ausgewählten Standorten an. Alle Felder innerhalb eines begonnenen Eintrags sind erforderlich."
      }
    }
  ],
  "fields": [
    {
      "label": "ETHICS_VOTE",
      "field_type": "FIXED",
      "active": false
    },
    {
      "label": "PROJECT_DESCRIPTION",
      "field_type": "FIXED",
      "properties": [
        "KEEP_FIXED_FIELD_ORDER"
      ],
      "description": {
        "en": "Please briefly describe your project in a few words (max 250)",
        "de": "TEST: Geben Sie einen kurzen Antragstitel ein."
      }
    },
    {
      "label": "research-objectives",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Research Objective(s)",
        "de": "Research Objective(s)"
      }
    },
    {
      "label": "project-duration",
      "mandatory": false,
