{
  "variables": {
    "form-title": {
      "en": "DATA REQUEST FORM",
      "de": "DATENANFRAGEFORMULAR"
    },
    "page": {
      "en": "Page",
      "de": "Seite"
    },
    "of": {
      "en": "of",
      "de": "von"
    }
  },
  "filename_templates": {
    "pdf": "cohort-${project-code}-${timestamp}.pdf"
  },
  "template_file": "request",
  "form_titles": [
    "project",
    "query"
  ],
  "template": "cohort",
  "display_name": {
    "en": "Data request"
  },
  "project_fields": [
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Your name and CCE-affiliation"
      },
      "value": "${creator-name-with-affiliations}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Email address"
      },
      "value": "${creator-email}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Request ID"
      },
      "description": {
        "en": "Technical ID for the request"
      },
      "value": "${project-code}"
    },
    {
      "mandatory": true,
      "data_type": "DATE",
      "display_format": "LONG_DATE_FORMAT",
      "display_name": {
        "en": "Request application date"
      },
      "value": "${project-creation-date}"
    },
    {
      "label": "PROJECT_TITLE",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Project Title"
      },
      "value": "${project-title}"
    },
    {
      "label": "PROJECT_DESCRIPTION",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Project Description"
      },
      "value": "${project-description}"
    },
    {
      "label": "ADDITIONAL_FILTER_CRITERIA",
      "mandatory": false,
      "data_type": "LONG_STRING",
      "display_name": {
        "en": "Additional filter criteria"
      },
      "value": "${additional-filter-criteria}"
    },
    {
      "label": "ETHICS_VOTE_FOR_ALL_SITES",
      "mandatory": false,
      "data_type": "STRING",
      "value": "${ethics-vote-for-all-sites-filename}"
    },
    {
      "label": "QUERIED_SITES",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Selected Sites"
      },
      "value": "${queried-sites}"
    },
    {
      "label": "ETHICS_VOTE",
      "mandatory": false,
      "active": false,
      "data_type": "LONG_STRING",
      "display_name": {
        "en": "Ethics vote per site"
      },
      "description": {
        "en": "Per-site ethics vote status, where a request may need one per queried site rather than a single vote for all sites"
      },
      "value": "${ethics-votes-per-site}"
    }
  ]
}