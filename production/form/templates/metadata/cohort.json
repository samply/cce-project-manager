{
  "variables": {
    "form-title": {
      "en": "DATA REQUEST FORM",
      "de": "DATENANFRAGEFORMULAR"
    },
    "page": {
      "en": "Page",
      "de": "Seite"
    },
    "of": {
      "en": "of",
      "de": "von"
    }
  },
  "filename_templates": {
    "pdf": "cohort-${project-code}-${timestamp}.pdf"
  },
  "template_file": "request",
  "template": "cohort",
  "display_name": {
    "en": "Data request",
    "de": "Datenanfrage"
  },
  "project_fields": [
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Name",
        "de": "Name"
      },
      "value": "${creator-name-with-affiliations}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Email address",
        "de": "E-Mail-Adresse"
      },
      "value": "${creator-email}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Request ID",
        "de": "Anfrage-ID"
      },
      "description": {
        "en": "Technical ID for the request",
        "de": "Technische ID der Anfrage"
      },
      "value": "${project-code}"
    },
    {
      "mandatory": true,
      "data_type": "DATE",
      "display_format": "LONG_DATE_FORMAT",
      "display_name": {
        "en": "Request application date",
        "de": "Antragsdatum der Anfrage"
      },
      "value": "${project-creation-date}"
    },
    {
      "label": "QUERIED_SITES",
      "form_title": "query",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Selected Sites",
        "de": "Ausgewählte Standorte"
      },
      "value": "${queried-sites}"
    },
    {
      "label": "ADDITIONAL_FILTER_CRITERIA",
      "mandatory": false,
      "data_type": "LONG_STRING",
      "display_name": {
        "en": "Additional filter criteria",
        "de": "Zusätzliche Filterkriterien"
      },
      "value": "${additional-filter-criteria}"
    },
    {
      "label": "PROJECT_TITLE",
      "form_title": "project",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Project Title",
        "de": "Projekttitel"
      },
      "value": "${project-title}"
    },
    {
      "label": "PROJECT_DESCRIPTION",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Project Description",
        "de": "Projektbeschreibung"
      },
      "value": "${project-description}"
    },
    {
      "label": "ETHICS_VOTE_FOR_ALL_SITES",
      "mandatory": false,
      "data_type": "STRING",
      "value": "${ethics-vote-for-all-sites-filename}"
    },
    {
      "label": "ETHICS_VOTE",
      "mandatory": false,
      "active": false,
      "data_type": "LONG_STRING",
      "display_name": {
        "en": "Ethics vote per site",
        "de": "Ethikvotum pro Standort"
      },
      "description": {
        "en": "Per-site ethics vote status, where a request may need one per queried site rather than a single vote for all sites.",
        "de": "Status des Ethikvotums pro Standort, wenn eine Anfrage statt eines einzigen Votums für alle Standorte eines pro abgefragtem Standort benötigt."
      },
      "value": "${ethics-votes-per-site}"
    }
  ]
}