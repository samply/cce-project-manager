{
  "title": "project",
  "display_name": {
    "en": "Project Information",
    "de": "Projektinformationen"
  },
  "description": {
    "en": "Please provide information about your project.",
    "de": "Bitte geben Sie Informationen zu Ihrem Projekt an."
  },
  "blocks": [
    {
      "label": "principal-investigator",
      "multiple": false,
      "min_instances": 1,
      "display_name": {
        "en": "Principal Investigator (Applicant)",
        "de": "Hauptverantwortlicher (Antragsteller)"
      },
      "description": {
        "en": "The applicant serves as the primary point of contact.",
        "de": "Der Antragsteller dient als primärer Ansprechpartner."
      }
    },
    {
      "label": "collaborators",
      "multiple": true,
      "display_name": {
        "en": "Collaborator",
        "de": "Kooperationspartner"
      },
      "description": {
        "en": "If applicable, please provide the names, affiliations, and email addresses of your collaborators at the chosen sites. If you add a collaborator, their first name, last name, affiliation, and email address are required.",
        "de": "Falls zutreffend, geben Sie bitte die Namen, Zugehörigkeiten und E-Mail-Adressen Ihrer Kooperationspartner an den ausgewählten Standorten an. Wenn Sie einen Kooperationspartner hinzufügen, sind Vorname, Nachname, Zugehörigkeit und E-Mail-Adresse erforderlich."
      }
    }
  ],
  "fields": [
    {
      "label": "ETHICS_VOTE",
      "field_type": "FIXED",
      "active": false
    },
    {
      "label": "PROJECT_DESCRIPTION",
      "field_type": "FIXED",
      "properties": [
        "KEEP_FIXED_FIELD_ORDER"
      ],
      "description": {
        "en": "Please briefly describe your project (max. 500 words).",
        "de": "Bitte beschreiben Sie Ihr Projekt kurz (max. 500 Wörter)."
      }
    },
    {
      "label": "methodology",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Data analysis methodology",
        "de": "Methodik der Datenanalyse"
      },
      "description": {
        "en": "Please provide a short description of the analysis method planned for use in your data request (e.g., federated data analysis).",
        "de": "Bitte geben Sie eine kurze Beschreibung der Analysemethode an, die für Ihre Datenanfrage geplant ist (z. B. föderierte Datenanalyse)."
      }
    },
    {
      "label": "research-objectives",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Research Objective(s)",
        "de": "Forschungsziel(e)"
      }
    },
    {
      "label": "project-duration",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Project duration (in months)",
        "de": "Projektdauer (in Monaten)"
      }
    },
    {
      "label": "planned-start-date",
      "mandatory": false,
      "data_type": "DATE",
      "display_format": "LONG_DATE_FORMAT",
      "display_name": {
        "en": "Planned Start Date of the Project",
        "de": "Geplantes Startdatum des Projekts"
      }
    },
    {
      "label": "planned-end-date",
      "mandatory": false,
      "data_type": "DATE",
      "display_format": "LONG_DATE_FORMAT",
      "display_name": {
        "en": "Planned End Date of the Project",
        "de": "Geplantes Enddatum des Projekts"
      }
    },
    {
      "label": "QUERIED_SITES",
      "field_type": "FIXED",
      "description": {
        "en": "Selected sites matching your search criteria in the Explorer.",
        "de": "Ausgewählte Standorte, die Ihren Suchkriterien im Explorer entsprechen."
      }
    },
    {
      "label": "principal_investigator_title",
      "mandatory": false,
      "data_type": "STRING",
      "block": "principal-investigator",
      "display_name": {
        "en": "Title",
        "de": "Titel"
